  <!-- 由清洗后的 URDF 生成：AR5V2_L.urdf。 -->
  <!-- mesh 文件位于assets/mesh/arm/AR5V2_L/。 -->
  <!-- 惯性说明：URDF 完整惯性矩阵已分解为 quat + diaginertia，便于物理引擎和可视化工具读取。 -->
  <!-- 编译器与仿真选项。 -->
  <compiler
    angle="radian"
    meshdir="."
  />
  <!-- gravity="0 0 -9.81" -->
  <option
    timestep="0.001"
    gravity="0 0 -9.81"
  />
  <!-- 默认参数：所有生成的 joint 和 geom 共用；URDF dynamics 会覆盖默认关节阻尼。 -->
