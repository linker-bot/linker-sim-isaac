#usda 1.0
(
    defaultPrim = "IndustrialWarehouse"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "IndustrialWarehouse"
{
    # Runtime root_pose owns the outer prim's xformOpOrder. Keep unit conversion
    # on this child so applying the scene pose cannot discard the 0.01 scale.
    def Xform "CentimeterAsset" (
        prepend references = @../../../usd-material/extracted/Industrial_NVD_10012/Assets/ArchVis/Industrial/Buildings/Warehouse/Warehouse01.usd@
    )
    {
        double3 xformOp:scale = (0.01, 0.01, 0.01)
        uniform token[] xformOpOrder = ["xformOp:scale"]

        # 上游仓库保持纯视觉表示；共面的 floor mesh 不能交给 MuJoCo CPU 作为碰撞体。
        # 解析 Plane 与视觉地板共用局部 z=0，随仓库根位姿一起移动，PhysX 与 Newton
        # 因而读取同一份物理事实，同时不会在渲染时叠加第二层可见地面。
        def Plane "FloorCollider" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            bool physics:collisionEnabled = 1
            token visibility = "invisible"
        }
    }
}
