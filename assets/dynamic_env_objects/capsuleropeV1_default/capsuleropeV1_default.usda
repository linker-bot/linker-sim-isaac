    def "Looks"
    {
        def Material "EndpointBoxMaterial"
        {
            token outputs:surface.connect = </CapsuleRope/Looks/EndpointBoxMaterial/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.34, 0.95)
                float inputs:roughness = 0.75
                token outputs:surface
            }
        }

        def Material "RopeMaterial"
        {
            token outputs:surface.connect = </CapsuleRope/Looks/RopeMaterial/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.62, 0.22)
                float inputs:roughness = 0.75
                token outputs:surface
            }
        }
    }

    def "PhysicsMaterials"
    {
        def Material "EndpointBoxMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.7
            uniform token physxMaterial:frictionCombineMode = "average"
        }
    }
}

